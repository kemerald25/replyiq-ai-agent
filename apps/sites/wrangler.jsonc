{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "replyiq-sites",
  "main": "src/index.ts",
  "compatibility_date": "2024-04-05",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "BASE_DOMAIN": "localhost",
    "BYPASS_HOSTS": "replyiq.cv,www.replyiq.cv,app.replyiq.cv",
    "STAGING_OVERRIDE_ENABLED": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "replyiq-db",
      "database_id": "local-d1-replyiq",
      "migrations_dir": "../../packages/core/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SITES_BUCKET",
      "bucket_name": "replyiq-sites"
    },
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "replyiq-assets"
    }
  ]
}
