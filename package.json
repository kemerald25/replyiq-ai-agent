{
  "name": "replyiq-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "test": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -b",
    "preview": "npm run --workspace=@replyiq/templates preview",
    "sites:dev": "npm run --workspace=@replyiq/sites dev",
    "sites:seed": "npm run --workspace=@replyiq/sites seed",
    "chat": "npm run --workspace=@replyiq/agent-app chat",
    "eval": "npm run --workspace=@replyiq/agent eval",
    "agent:dev": "npm run --workspace=@replyiq/agent-app dev",
    "agent:seed": "npm run --workspace=@replyiq/agent-app seed",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\""
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261005.1",
    "@eslint/js": "^9.21.0",
    "@vitest/coverage-v8": "^3.0.7",
    "eslint": "^9.21.0",
    "prettier": "^3.5.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.25.0",
    "vitest": "^3.0.7",
    "wrangler": "^4.147.0"
  }
}
