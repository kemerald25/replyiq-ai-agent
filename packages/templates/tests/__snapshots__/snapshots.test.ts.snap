      white-space: pre-line;
    }
    .about-media {
      max-width: 500px;
      border-radius: 12px;
      overflow: hidden;
    }
    .about-img {
      width: 100%;
      height: auto;
      display: block;
    }
    @media (min-width: 768px) {
      .about-container {
        flex-direction: row;
        align-items: center;
      }
      .about-content {
        flex: 1;
      }
      .about-media {
        flex: 1;
      }
    }

    /* Services Section */
    .service-card {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
    .service-media {
      margin: -1.25rem -1.25rem 0.75rem -1.25rem;
